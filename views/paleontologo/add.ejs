<%- include('../cabecalho')%>


    <div>
        <tr><a href="../paleontologo"> ← Voltar </a></tr>
        <h3>Novo Paleontólogo</h3>


        <form method="post">
            <p>Nome</p>
            <input type="text" placeholder="Nome do Paleontólogo" name="nome">
            <br>
            <p>Nascimento</p>
            <input type="number" value="2026" name="nascimento">
            <br>
            <p>Descoberta</p>
            <input type="text" placeholder="Espécies, Dinossauros, etc..." name="descoberta">
            <br><br>
            <button type="submit">Adicionar</button>
            <button type="reset">Cancelar</button>
        </form>
    </div>
    </body>

    </html>